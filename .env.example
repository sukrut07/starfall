# ==============================================================================
# STARFALL Configuration Environment Template
# Copy to .env (cp .env.example .env) to customize your local configuration.
# Local Ollama inference does not require a cloud API key by default.
# Never commit .env with private tokens or secrets to git.
# ==============================================================================

# Ollama Inference Configuration
# Note: http://localhost:11434 is suitable for local development.
# A Vercel cloud deployment cannot reach localhost on your laptop.
# In production, set OLLAMA_HOST to a reachable hosted endpoint or leave it
# unconfigured to automatically use the robust deterministic tactical fallback.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=8
STARFALL_AI_ENABLED=true

# Local Game Engine Settings (Desktop)
STARFALL_RENDERER=pygame
STARFALL_CONTROL=keyboard
STARFALL_CAMERA_INDEX=0
STARFALL_DEBUG=false
STARFALL_DB_PATH=starfall.db
