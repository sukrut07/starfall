# ==============================================================================
# STARFALL Configuration Environment File
# Copy to .env (cp .env.example .env) to customize your local configuration.
# Local Ollama inference does not require a cloud API key by default.
# Never commit .env with private tokens to git.
# ==============================================================================

# Local Ollama Inference (Open-Weights Gemma 4)
OLLAMA_HOST=http://localhost:11434
# Choose between gemma4:e2b (faster, 7.5GB) or gemma4:e4b (deeper reasoning, 9.5GB)
# Confirm installed models with: ollama list
OLLAMA_MODEL=gemma4:e4b

# Optional: If connecting to a remote Gemma 4 endpoint, gateway, or hosted API:
# GEMMA_API_KEY=your_optional_api_key_here
# OLLAMA_API_KEY=your_optional_api_key_here

# Runtime Settings
STARFALL_RENDERER=pygame     # pygame or terminal
STARFALL_CONTROL=keyboard    # keyboard, gesture, or mixed
STARFALL_CAMERA_INDEX=0      # Default webcam index
STARFALL_DEBUG=false
STARFALL_DB_PATH=starfall.db
