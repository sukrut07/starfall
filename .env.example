# STARFALL local configuration. No cloud API key is required for Ollama.
# Copy to .env; these values are configuration, not secrets.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
STARFALL_RENDERER=pygame
STARFALL_CONTROL=gesture
STARFALL_CAMERA_INDEX=0
STARFALL_DEBUG=false
STARFALL_DB_PATH=starfall.db

# To use a smaller model on constrained hardware, set OLLAMA_MODEL=gemma4:e2b.
# Confirm a model is installed with: ollama list
